# Copy this file to `.env` and fill in your FortyGuard API key.
# The app and notebooks load this automatically via python-dotenv.

FORTYGUARD_API_KEY=your_api_key_here

# Optional — override the default production base URL.
# Development: https://tos-enterprise-api.dev.app.fortyguard.com
# Production:  https://api.fortyguard.com
FORTYGUARD_BASE_URL=https://api.fortyguard.com

# Optional: enables the conversational HeatWise Assistant.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5.6-luna

# Recommended free-tier conversational provider.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
# Public Mapbox token used only for the interactive basemap (starts with pk.).
MAPBOX_ACCESS_TOKEN=
